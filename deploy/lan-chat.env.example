# This file contains identifiers and settings only. Secret values stay in AWS
# Secrets Manager and AWS credentials come from the EC2 instance role.
APP_ENV=production
AWS_REGION=ap-south-1

DATABASE_SECRET_ID=replace-with-the-full-rds-managed-secret-arn
DB_NAME=lan_chat
RDS_CA_BUNDLE=/etc/pki/ca-trust/source/anchors/global-bundle.pem

MEDIA_BACKEND=s3
S3_BUCKET=replace-with-your-private-bucket-name
# Leave blank to use S3-managed AES-256 encryption. If set, grant the EC2 role
# the required KMS permissions as well.
S3_KMS_KEY_ID=

CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
CLOUDFRONT_PUBLIC_KEY_ID=K111111EXAMPLE
CLOUDFRONT_PRIVATE_KEY_SECRET_ID=lan-chat/production/cloudfront-private-key
CLOUDFRONT_URL_TTL_SECONDS=900

ALLOWED_HOSTS=chat.example.com
ALLOWED_ORIGINS=https://chat.example.com
FORCE_HTTPS=true
COOKIE_SECURE=true
SESSION_DAYS=7

MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=52428800
